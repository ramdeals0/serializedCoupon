# Local development without Docker / PostgreSQL.
# Copy values into your shell; do not commit real secrets.

# Backend
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
CORS_ALLOWED_ORIGINS=http://localhost:4200

JWT_SECRET=local-dev-jwt-secret-change-me-32bytes-min
AUTH_ADMIN_PASSWORD=Admin123!
AUTH_MANAGER_PASSWORD=Manager123!
AUTH_CSR_PASSWORD=Csr123!

# PostgreSQL profile (SPRING_PROFILES_ACTIVE=postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=serialized_coupon
POSTGRES_USER=coupon
POSTGRES_PASSWORD=coupon

# RMS
# mock (default) or rest
RMS_CLIENT=mock
RMS_BASE_URL=
RMS_API_KEY=

# Generation
COUPON_MAX_BATCH_SIZE=10000
COUPON_COLLISION_RETRY_LIMIT=20
COUPON_REQUIRE_LIVE_RMS=true

# External POS / e-comm APIs (header X-Api-Key)
EXTERNAL_API_KEY=pos-demo-key
